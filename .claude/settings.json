{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Read(./**/*.ignore)",
      "Read(./**/*.ignore.*)",
      "Read(./.venv/**)",
      "Read(./**/__pycache__/**)",
      "Read(./build/**)",
      "Read(./verna.egg-info/**)",
      "Read(./.do/app.yaml)",
      "Read(./.idea/**)"
    ],
    "allow": [
      "Edit",
      "Write",
      "WebSearch",
      "WebFetch",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git ls-tree:*)",
      "Bash(uv run python -m py_compile:*)",
      "Bash(uv run python -m verna.create_spec:*)",
      "Bash(uv run ruff check:*)",
      "Bash(uv run ruff format:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv lock:*)",
      "Bash(uv sync:*)",
      "Bash(uv add:*)",
      "Bash(uv tool install:*)",
      "Bash(ls:*)"
    ]
  }
}
